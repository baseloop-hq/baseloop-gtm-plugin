{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "include-component-in-tag": true,
  "release-search-depth": 20,
  "commit-search-depth": 50,
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "cli",
      "exclude-paths": [
        "plugins/",
        "docs/",
        "scripts/references/",
        ".claude-plugin/",
        "AGENTS.md",
        "CLAUDE.md",
        "README.md",
        "LICENSE"
      ],
      "extra-files": [
        {
          "type": "json",
          "path": "package.json",
          "jsonpath": "$.version"
        }
      ]
    },
    "plugins/baseloop-gtm": {
      "release-type": "simple",
      "package-name": "baseloop-gtm",
      "extra-files": [
        {
          "type": "json",
          "path": ".claude-plugin/plugin.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "codex/.codex-plugin/plugin.json",
          "jsonpath": "$.version"
        }
      ]
    },
    ".claude-plugin": {
      "release-type": "simple",
      "package-name": "marketplace",
      "extra-files": [
        {
          "type": "json",
          "path": "marketplace.json",
          "jsonpath": "$.metadata.version"
        }
      ]
    }
  },
  "plugins": [
    {
      "type": "linked-versions",
      "groupName": "baseloop-gtm",
      "components": ["cli", "baseloop-gtm", "marketplace"]
    }
  ]
}
