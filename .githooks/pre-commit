#!/usr/bin/env bash
#
# Pre-commit hook: sync marketplace.json from plugin.json sources.
# If any plugin.json was modified, re-sync and stage the result.
#
set -euo pipefail

ROOT_DIR="$(git rev-parse --show-toplevel)"
MARKETPLACE=".claude-plugin/marketplace.json"
PLUGIN_JSON="$ROOT_DIR/plugins/baseloop-gtm/.claude-plugin/plugin.json"

# Only run if a plugin.json was staged
if git diff --cached --name-only | grep -q '\.claude-plugin/plugin\.json$'; then
  # Update the first (only) plugin entry with version + description from plugin.json
  jq --slurpfile src "$PLUGIN_JSON" '
    .plugins[0].version = $src[0].version |
    .plugins[0].description = $src[0].description
  ' "$ROOT_DIR/$MARKETPLACE" > "$ROOT_DIR/$MARKETPLACE.tmp" && mv "$ROOT_DIR/$MARKETPLACE.tmp" "$ROOT_DIR/$MARKETPLACE"

  echo "marketplace.json synced to v$(jq -r '.plugins[0].version' "$ROOT_DIR/$MARKETPLACE")"
  git add "$MARKETPLACE"
fi
